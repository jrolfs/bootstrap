{
  "version": 1,
  "secrets": {
    "default-secret-keys": {
      "kind": "document",
      "reference": "op://Secrets/GPG default secret keys",
      "description": "Armored secret keys for the default keyring",
      "mode": "0600",
      "hosts": [
        "*"
      ]
    },
    "default-public-keys": {
      "kind": "document",
      "reference": "op://Secrets/GPG default public keys",
      "description": "All public keys in the default keyring, including third parties",
      "mode": "0600",
      "hosts": [
        "*"
      ]
    },
    "default-ownertrust": {
      "kind": "document",
      "reference": "op://Secrets/GPG default ownertrust",
      "description": "Ownertrust for the default keyring",
      "mode": "0600",
      "hosts": [
        "*"
      ]
    },
    "fondo-secret-keys": {
      "kind": "document",
      "reference": "op://Secrets/GPG fondo secret keys",
      "description": "Armored secret keys for the fondo keyring",
      "mode": "0600",
      "gnupgHome": ".gnupg-fondo",
      "hosts": [
        "newt",
        "ala"
      ]
    },
    "fondo-public-keys": {
      "kind": "document",
      "reference": "op://Secrets/GPG fondo public keys",
      "description": "All public keys in the fondo keyring, including third parties",
      "mode": "0600",
      "gnupgHome": ".gnupg-fondo",
      "hosts": [
        "newt",
        "ala"
      ]
    },
    "fondo-ownertrust": {
      "kind": "document",
      "reference": "op://Secrets/GPG fondo ownertrust",
      "description": "Ownertrust for the fondo keyring",
      "mode": "0600",
      "gnupgHome": ".gnupg-fondo",
      "hosts": [
        "newt",
        "ala"
      ]
    },
    "github-credentials": {
      "kind": "field",
      "reference": "op://Secrets/GitHub HTTPS credentials/credential",
      "description": "git-credential-store line for github.com, read during activation by brew bundle before home-manager exists",
      "target": ".git-credentials",
      "mode": "0600",
      "hosts": [
        "*"
      ]
    }
  }
}
